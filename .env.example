# Copy to .env; never commit real credentials or access tokens.
ENTRA_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
# Client-ID GUID of the resource/API registration, not its api:// URI.
ENTRA_API_AUDIENCE=
OPENTDF_PLATFORM_URL=https://your-platform.example.com
OPENTDF_KAS_URL=https://your-platform.example.com/kas
OPENTDF_ATTRIBUTE=https://demo.opentdf.local/attr/project/value/alpha
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=files
# Azure runtime: user-assigned managed identity client ID. Local: omit and use az login.
AZURE_CLIENT_ID=
PORT=3000
